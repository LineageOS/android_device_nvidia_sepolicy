type symlink_data, domain;
type symlink_data_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(symlink_data)

allow symlink_data vendor_toolbox_exec:file rx_file_perms;

allow symlink_data block_device:dir search;
allow symlink_data userdata_block_device:blk_file r_file_perms;
allow symlink_data block_device:dir rw_dir_perms;
allow symlink_data block_device:lnk_file create_file_perms;

recovery_only(`
  allow symlink_data rootfs:dir r_dir_perms;
  allow symlink_data rootfs:file { entrypoint rx_file_perms };
')
